pipeline {
    agent {
        docker {
            image 'abhishekf5/maven-abhishek-docker-agent:v1'
            args '--user root -v /var/run/docker.sock:/var/run/docker.sock -v /root/.m2:/root/.m2'
        }
    }

    environment {
        APP_DIR = 'java-maven-sonar-argocd-helm-k8s/spring-boot-app'
        MANIFEST_DIR = 'java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests'

        // SonarQube
        SONAR_URL = 'http://13.218.47.87:9000'

        // Docker Hub
        DOCKER_IMAGE = "charan1412/ultimate-cicd:${BUILD_NUMBER}"

        // GitHub
        GIT_REPO_NAME = "Jenkins-Zero-To-Hero"
        GIT_USER_NAME = "Charan1802"
    }

    stages {

        stage('Checkout') {
            steps {
                sh 'ls -ltr'
            }
        }

        stage('Build and Test') {
            steps {
                dir("${APP_DIR}") {
                    sh '''
                        mvn clean package \
                        -Dorg.slf4j.simpleLogger.log.org.apache.maven.cli.transfer.Slf4jMavenTransferListener=warn
                    '''
                }
            }
        }

        stage('Static Code Analysis') {
            steps {
                dir("${APP_DIR}") {
                    withCredentials([
                        string(
                            credentialsId: 'SonarQube',
                            variable: 'SONAR_AUTH_TOKEN'
                        )
                    ]) {
                        sh '''
                            mvn sonar:sonar \
                            -Dsonar.login="$SONAR_AUTH_TOKEN" \
                            -Dsonar.host.url="$SONAR_URL"
                        '''
                    }
                }
            }
        }

        stage('Build and Push Docker Image') {
            steps {
                dir("${APP_DIR}") {
                    script {

                        // Build Docker image
                        sh '''
                            docker build -t ${DOCKER_IMAGE} .
                        '''

                        // Login to Docker Hub
                        withCredentials([
                            usernamePassword(
                                credentialsId: 'docker-hub-credentials',
                                usernameVariable: 'DOCKER_USER',
                                passwordVariable: 'DOCKER_PASS'
                            )
                        ]) {
                            sh '''
                                echo "$DOCKER_PASS" | docker login \
                                --username "$DOCKER_USER" \
                                --password-stdin
                            '''

                            // Push Docker image
                            sh '''
                                docker push ${DOCKER_IMAGE}
                            '''
                        }
                    }
                }
            }
        }

        stage('Update Deployment File') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'Git',
                        variable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        git config user.email "saicharansiddabathula6@gmail.com"
                        git config user.name "Charan"

                        sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" \
                        ${MANIFEST_DIR}/deployment.yml

                        git add ${MANIFEST_DIR}/deployment.yml

                        git commit \
                        -m "Update deployment image to version ${BUILD_NUMBER} [skip ci]" \
                        || echo "No changes to commit"

                        git push \
                        https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git \
                        HEAD:main
                    '''
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}

